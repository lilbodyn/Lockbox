digraph LockboxStates {
  graph [rankdir=TB, bgcolor="white", pad="0.15", nodesep="0.65", ranksep="0.8"];
  node [shape=box, style="rounded,filled", fillcolor="#f3f6f8", color="#364a5c", fontname="Times New Roman", fontsize=18, margin="0.18,0.12"];
  edge [color="#364a5c", fontname="Times New Roman", fontsize=15, arrowsize=0.8];
  off [label="OFF\nзнято з охорони"];
  cal [label="CALIBRATING\n25 стабільних вимірів"];
  armed [label="ARMED\nпід охороною"];
  alarm [label="ALARM\nSHOCK та/або LIGHT\nзафіксовано", fillcolor="#fff0ed"];
  off -> cal [label="кнопка / arm"];
  cal -> armed [label="стабільне вікно"];
  cal -> off [label="2 с без успіху"];
  armed -> alarm [label="струс / різка зміна світла"];
  cal -> off [label="кнопка / disarm", color="#7a7a7a"];
  armed -> off [label="кнопка / disarm", color="#7a7a7a"];
  alarm -> off [label="кнопка / disarm\nочистити причини"];
  alarm -> alarm [label="додати другу причину"];
  {rank=same; off; cal}
  {rank=same; armed; alarm}
}
